extends layout

block content
  h1.mb-4 Modifier le produit
  if error
    p.text-danger #{error}
  form(method="POST")
    .mb-3
      label.form-label Société
      input.form-control(type="text", name="society", value=product.society)
    .mb-3
      label.form-label Prix
      input.form-control(type="number", name="price", value=product.price)
    .mb-3
      label.form-label Quantité
      input.form-control(type="number", name="qty", value=product.qty)
    .mb-3
      label.form-label Année
      input.form-control(type="number", name="year", value=product.year)
    button.btn.btn-warning(type="submit") Modifier
