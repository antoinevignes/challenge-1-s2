extends layout

block content
  h1.mb-4 Ajouter un produit
  if error
    p.text-danger #{error}
  form(method="POST", action="/add")
    .mb-3
      label.form-label Société
      input.form-control(type="text", name="society")
    .mb-3
      label.form-label Prix
      input.form-control(type="number", name="price")
    .mb-3
      label.form-label Quantité
      input.form-control(type="number", name="qty")
    .mb-3
      label.form-label Année
      input.form-control(type="number", name="year")
    .mb-3
      label.form-label Taille H
      input.form-control(type="number", name="size[h]")
    .mb-3
      label.form-label Taille W
      input.form-control(type="number", name="size[w]")
    .mb-3
      label.form-label UOM
      input.form-control(type="text", name="size[uom]")
    button.btn.btn-success(type="submit") Ajouter
