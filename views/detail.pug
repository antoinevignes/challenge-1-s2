extends layout

block content
  h1.mb-4 Détails du produit
  table.table.table-striped
    tr
      th Société
      td #{product.society}
    tr
      th Prix
      td #{product.price}
    tr
      th Quantité
      td #{product.qty}
    tr
      th Année
      td #{product.year}
    tr
      th Taille
      td #{product.size.h} x #{product.size.w} #{product.size.uom}
  a.btn.btn-warning.mt-3(href=`/modify/${product._id}`) Modifier
